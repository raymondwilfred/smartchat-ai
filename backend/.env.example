# Server Port
PORT=5000

# LLM Provider: 'openai' (default) or 'gemini'
LLM_PROVIDER=openai

# OpenAI API Key (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Context Window Limit (Number of recent messages to retain in memory payload)
CONTEXT_WINDOW_LIMIT=10
